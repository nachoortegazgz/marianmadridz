      },
      "assertions": ["contact request reaches CRM", "marketing opt-in is separate", "unsubscribe persists and suppresses further sends"],
      "limitation": "Public form delivery, Wix Contacts and Automations are not exercised in this offline suite."
    },
    {
      "scenarioId": "QA-RESCHEDULE-001",
      "name": "Reprogramación completa",
      "status": "MANUAL_QA_REQUIRED",
      "testFiles": [],
      "traceId": "trace-qa-reschedule-001",
      "fixture": {
        "oldDateYmd": "2026-11-10",
        "newDateYmd": "2026-11-12",
