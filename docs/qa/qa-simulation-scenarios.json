        "src/backend/tests/qa.simple-booking.writer.offline.test.mjs"
      ],
      "traceId": "trace-qa-simple-001",
      "fixture": {
        "serviceSlug": "qa-corte-simple",
        "servicePrice": 50,
        "durationMinutes": 60,
        "dateYmd": "2026-11-04",
        "startLocal": "2026-11-04T10:00:00",
        "endLocal": "2026-11-04T11:00:00",
        "customerEmail": "qa.simple@example.test",
        "channelType": "PRESENCIAL"
      },
      "assertions": [
        "availability consulted",
        "one Bookings Writer V2 create",
        "one confirmation",
        "one CitasF2 projection",
        "idempotent replay creates no duplicate"
      ]
    },
    {
