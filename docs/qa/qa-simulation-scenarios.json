    },
    {
      "scenarioId": "QA-GIFTCARD-001",
      "name": "Gift Card / bono",
      "status": "MANUAL_QA_REQUIRED",
      "testFiles": [],
      "traceId": "trace-qa-giftcard-001",
      "fixture": {
        "giftCardId": "qa-gift-card-001",
