{
    "settings": {
        "timeZone": "Europe/Madrid",
        "concurrencyPolicy": "Forbid",
        "timeout": 300,
        "retryPolicy": {
            "maxRetries": 3,
            "backoffMultiplier": 2,
            "initialDelaySeconds": 60
        }
    },
    "jobs": [
        {
            "name": "cleanExpiredLocks",
            "functionLocation": "/crons.js",
            "functionName": "cleanExpiredLocks",
            "description": "Purga de cerrojos mutex expirados con ventana de gracia",
            "executionConfig": {
                "cronExpression": "15 * * * *",
                "timeout": 60
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "cleanExpiredRateLimits",
            "functionLocation": "/crons.js",
            "functionName": "cleanExpiredRateLimits",
            "description": "Purga segura de contadores RATE_LIMIT expirados en ControlOperativo",
            "executionConfig": {
                "cronExpression": "*/5 * * * *",
                "timeout": 60
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "cleanupExpiredDualCache",
            "functionLocation": "/crons.js",
            "functionName": "cleanupExpiredDualCache",
            "description": "Purga de pares de slots duales en cache expirados",
            "executionConfig": {
                "cronExpression": "20 * * * *",
                "timeout": 60
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "runPendingCompensationsJob",
            "functionLocation": "/crons.js",
            "functionName": "runPendingCompensationsJob",
            "description": "Procesador de compensaciones de reservas y recuperacion de ledger",
            "executionConfig": {
                "cronExpression": "30 * * * *",
                "timeout": 180
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 2
            }
        },
        {
            "name": "cleanExpiredDaysCache",
            "functionLocation": "/crons.js",
            "functionName": "cleanExpiredDaysCache",
            "description": "Purga diaria de cache de dias disponibles",
            "executionConfig": {
                "cronExpression": "0 1 * * *",
                "timeout": 120
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "verifyNightlyZClosing",
            "functionLocation": "/crons.js",
            "functionName": "verifyNightlyZClosing",
            "description": "Cierre Z automatico y sellado del dia anterior en hora Madrid",
            "executionConfig": {
                "cronExpression": "20 1 * * *",
                "timeout": 180
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 1
            }
        },
        {
            "name": "systemHealthCheck",
            "functionLocation": "/crons.js",
            "functionName": "systemHealthCheck",
            "description": "Chequeo diario de salud de bases de datos, secretos y ledger",
            "executionConfig": {
                "cronExpression": "0 7 * * *",
                "timeout": 120
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 2
            }
        },
        {
            "name": "cleanAuditLogs",
            "functionLocation": "/crons.js",
            "functionName": "cleanAuditLogs",
            "description": "Mantenimiento semanal de retencion de logs (90 dias)",
            "executionConfig": {
                "cronExpression": "0 2 * * 0",
                "timeout": 300
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "reconcileUnknownTransactions",
            "functionLocation": "/crons.js",
            "functionName": "reconcileUnknownTransactions",
            "description": "Reconciliacion de transacciones Wix Pay desconocidas (desconexiones post-cargo)",
            "executionConfig": {
                "cronExpression": "45 * * * *",
                "timeout": 120
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "reconcileInconsistentDualPairs",
            "functionLocation": "/crons.js",
            "functionName": "reconcileInconsistentDualPairs",
            "description": "Deteccion y compensacion de pares Bookings-CMS inconsistentes post-reprogramacion",
            "executionConfig": {
                "cronExpression": "50 * * * *",
                "timeout": 120
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        },
        {
            "name": "retryCompletionRequired",
            "functionLocation": "/crons.js",
            "functionName": "retryCompletionRequired",
            "description": "Reintento de reservas en estado COMPLETION_REQUIRED con TTL",
            "executionConfig": {
                "cronExpression": "55 * * * *",
                "timeout": 120
            },
            "alerting": {
                "onFailure": true,
                "onConsecutiveFailures": 3
            }
        }
    ]
}
